# ==========================================
# Python & Окружение
# ==========================================
# Виртуальное окружение
.venv/
venv/
ENV/
env/

# Кэш байт-кода Python
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Расширения C (если появятся в будущем)
*.so

# ==========================================
# Файлы операционной системы и GUI
# ==========================================
# Специфично для Linux / GTK / DE
.directory
.Trash-*/
*~

# Если проект когда-либо откроется в IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# Результаты тестов и локальные файлы
# ==========================================
# Исключаем сгенерированные тестовые документы DOCX
Test/emydocx-document.docx
build
build/*

# Если в папке Test будут другие генерируемые файлы, 
# но саму папку или шаблоны тестов нужно сохранить:
# Test/*.docx

# Локальные логи (например, если добавите логгер)
*.log
